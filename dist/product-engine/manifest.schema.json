{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Atlas Product Manifest v1",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "geometry", "dimensionsMm", "dimensionEvidence", "parts", "assembly"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "name": {"$ref": "#/definitions/localized"},
    "geometry": {"enum": ["rectangular-panel", "atlas-reference"]},
    "role": {"enum": ["guardian", "warrior", "archer", "assassin", "mage", "boss"]},
    "dimensionsMm": {"type": "object", "required": ["width", "height", "depth"], "properties": {"width": {"$ref": "#/definitions/mm"}, "height": {"$ref": "#/definitions/mm"}, "depth": {"$ref": "#/definitions/mm"}}},
    "dimensionEvidence": {"enum": ["assumed", "measured"]},
    "parts": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": "object", "required": ["id", "name", "quantity", "unit", "evidence", "sources"], "properties": {
      "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}, "name": {"$ref": "#/definitions/localized"},
      "quantity": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000}, "unit": {"$ref": "#/definitions/text"},
      "evidence": {"enum": ["assumed", "referenced", "measured"]},
      "sources": {"type": "array", "items": {"type": "object", "required": ["url", "title", "checkedAt"], "properties": {"url": {"type": "string", "pattern": "^https://"}, "title": {"$ref": "#/definitions/text"}, "checkedAt": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}}}}
    }}},
    "assembly": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": "object", "required": ["partIds", "instruction", "passGate"], "properties": {"partIds": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "instruction": {"$ref": "#/definitions/localized"}, "passGate": {"$ref": "#/definitions/localized"}}}}
  },
  "if": {"properties": {"geometry": {"const": "atlas-reference"}}, "required": ["geometry"]},
  "then": {"required": ["role"]},
  "definitions": {
    "text": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S"},
    "localized": {"type": "object", "required": ["vi", "en"], "properties": {"vi": {"$ref": "#/definitions/text"}, "en": {"$ref": "#/definitions/text"}}},
    "mm": {"type": "number", "exclusiveMinimum": 0, "maximum": 2000}
  }
}
